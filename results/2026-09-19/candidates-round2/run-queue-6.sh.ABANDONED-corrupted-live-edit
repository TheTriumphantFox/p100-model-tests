#!/usr/bin/env bash
# Round 2b, 2026-09-20. Two jobs:
#   A. Score the three Qwen3.8-27B quants dropped in ~/Downloads/Models (all arch qwen35,
#      so all three run on the production ~/llama-cuda12 build -- no fork needed).
#   B. Re-run MMLU-Pro with thinking ENABLED for the reasoning models, into their own
#      mmlu-<slug>-think4096/ dirs. The thinking-OFF dirs are never touched: they are the
#      only numbers comparable to the shelf baselines.
#
# Guards, all for traps this rig has actually sprung:
#   * the router enumerates --models-dir once at startup -> assert_listed before every bench
#   * --models-max 1 leaves the last model resident -> restart + assert an empty GPU before
#     each of the big Q8_0/Q6_K loads
#   * a sub-minute benchmark is a rig failure, not a model result -> flagged RIG-FAIL
set -uo pipefail
T=~/Projects/Tests
RUN=$T/2026-09-19/candidates-round2
BM=~/llama-bench-models
log() { echo "[$(date +%T)] $*" | tee -a "$RUN/driver.log"; }
router_pid() { ss -ltnpH "sport = :8081" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1; }
gpu_mib() { nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | paste -sd+ | bc; }

stop_router() {
  p=$(router_pid); [ -n "$p" ] && { kill "$p"; for i in $(seq 1 60); do sleep 2; [ -z "$(router_pid)" ] && break; done; }
  sleep 5
  log "router stopped (was pid ${p:-none}); GPU now $(gpu_mib) MiB"
}
start_router() {
  nohup env LD_LIBRARY_PATH=$1/lib $1/bin/llama-server \
    --models-dir $BM --models-autoload --models-max 1 \
    --host 127.0.0.1 --port 8081 --ctx-size 8192 --split-mode layer \
    --cache-type-k f16 --cache-type-v f16 --flash-attn on --jinja \
    --parallel 1 --batch-size 512 --ubatch-size 512 >> "$RUN/router-8081.log" 2>&1 &
  for i in $(seq 1 90); do sleep 2; [ -n "$(router_pid)" ] && break; done
  p=$(router_pid)
  log "router started from $1 ($(cut -c1-12 $1/LLAMA_COMMIT 2>/dev/null), pid ${p:-FAILED-TO-START})"
  [ -n "$p" ]
}
# The 0/0-in-two-seconds trap: a GGUF symlinked in after the router booted is invisible.
assert_listed() {
  ids=$(curl -sf --max-time 30 http://127.0.0.1:8081/models | python3 -c 'import json,sys; print(" ".join(m["id"] for m in json.load(sys.stdin)["data"]))' 2>/dev/null)
  case " $ids " in *" $1 "*) return 0;; esac
  log "!!! RIG-FAIL: router does not list '$1'. Listed: $ids"; return 1
}
# The shim gates /api/tags on its TAGS dict; a model missing there is invisible to the harness.
assert_shim_tag() {
  if curl -sf --max-time 30 "http://127.0.0.1:$2/api/tags" | grep -q "\"$1\""; then return 0; fi
  log "!!! RIG-FAIL: shim on :$2 does not advertise tag '$1'"; return 1
}
fresh_router() {  # $1 = runtime dir, $2 = router id that must be listed
  stop_router
  u=$(gpu_mib); [ "$u" -gt 2000 ] && log "!!! WARN: ${u} MiB still on the GPU before load"
  start_router "$1" || return 1
  assert_listed "$2"
}

log "================ QUEUE-6 START ================"

# --- wait for queue-5 (g9v3 HumanEval) to land before touching anything ---------------
# Match on the bash process running the script, not on any cmdline mentioning its name:
# a bare `pgrep -f run-queue-5.sh` also matches any watcher shell that has the string in
# its own argv, and then this loop never exits. [[pkill-self-match-pitfall]], across procs.
while pgrep -x bash -f 'run-queue-5\.sh' >/dev/null; do sleep 60; done
log "queue-5 has exited; taking over the rig"

# --- shims: restart :11500 so it picks up the three new TAGS, add :11501 forcing think --
pkill -f 'ollama_shim.py --router http://127.0.0.1:8081 --port 115'
sleep 3
cd "$T"
nohup python3 scripts/ollama_shim.py --router http://127.0.0.1:8081 --port 11500 \
  >> "$RUN/shim-11500.log" 2>&1 &
nohup python3 scripts/ollama_shim.py --router http://127.0.0.1:8081 --port 11501 --force-think \
  >> "$RUN/shim-11501-think.log" 2>&1 &
sleep 3
log "shims up: $(ss -ltnH 'sport = :11500 or sport = :11501' | awk '{print $4}' | paste -sd' ')"

# ================== PHASE B: MMLU-Pro with thinking ON, reasoning models ===============
# Named in the brief: ornith, nemotron, xing. g9v3 is added because it has the identical
# tell (@96 and @2048 both 67.14%) and is the same class of model -- reported as an extra.
log "--- PHASE B: thinking-on MMLU-Pro ---"
if fresh_router ~/llama-cuda12 ornith-1.5-35b-a3b_q4_k_m; then
  assert_shim_tag 'ornith-1.5-35b-a3b:q4_k_m' 11501 && "$RUN/bench_think.sh" 'ornith-1.5-35b-a3b:q4_k_m' ornith 4096
  assert_listed nemotron-cascade-2-30b-a3b_q4_k_m \
    && "$RUN/bench_think.sh" 'nemotron-cascade-2-30b-a3b:q4_k_m' nemotron 4096
fi
if fresh_router ~/llama-cuda12-xing xing4.0-29b-a4b_iq4_nl; then
  "$RUN/bench_think.sh" 'xing4.0-29b-a4b:iq4_nl' xing 4096
fi
if fresh_router ~/llama-cuda12-g9v3 g9v3-39a5b_q4_k_m; then
  "$RUN/bench_think.sh" 'g9v3-39a5b:q4_k_m' g9v3 4096
fi

# ======================= PHASE A: the three new Qwen3.8 quants =========================
# Q8_0 is 27.0 GiB and UD-Q6_K/Q6_K_P are 20.5/24.1 GiB -- each gets a fresh router so it
# is never competing with a resident predecessor for the 32 GiB.
runA() { # $1 router-id  $2 tag  $3 slug
  log "--- PHASE A: $3 ---"
  if fresh_router ~/llama-cuda12 "$1" && assert_shim_tag "$2" 11500; then
    "$RUN/bench_one2.sh" "$2" "$3"
  else
    log "!!! SKIPPED $3: preflight failed"
  fi
}
runA qwen3.8-27b-unsloth_ud_q6_k               'qwen3.8-27b-unsloth:ud_q6_k'          qwen38-ud-q6k
runA qwen3.8-27b-uncensored-hauhaucs_q6_k_p    'qwen3.8-27b-uncensored-hauhaucs:q6_k_p' qwen38-uncensored-q6kp
runA qwen3.8-27b-unsloth_q8_0                  'qwen3.8-27b-unsloth:q8_0'             qwen38-unsloth-q8

# --- back to steady state -------------------------------------------------------------
stop_router
start_router ~/llama-cuda12
log "================ QUEUE-6 DONE ================"
