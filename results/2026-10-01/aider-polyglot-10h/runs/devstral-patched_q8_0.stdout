book_store.go
```
package bookstore

func Cost(books []int) int {
    // Count occurrences of each book (1-5)
    counts := make([]int, 5)
    for _, book := range books {
        counts[book-1]++
    }

    // Calculate the maximum discount by trying all possible groupings
    // We'll use a greedy approach to maximize discounts
    total := 0
    remaining := make([]int, 5)
    copy(remaining, counts)

    // Try to form groups of 5, then 4, then 3, then 2
    for len(remaining) > 0 {
        // Try to form a group of 5
        if remaining[0] > 0 && remaining[1] > 0 && remaining[2] > 0 && remaining[3] > 0 && remaining[4] > 0 {
            total += 5 * 600 // 5 books at 25% discount = $6 each
            for i := range remaining {
                remaining[i]--
            }
            continue
        }

        // Try to form a group of 4
        found := false
        for i := 0; i < 5; i++ {
            if remaining[i] == 0 {
                continue
            }
            for j := i + 1; j < 5; j++ {
                if remaining[j] == 0 {
                    continue
                }
                for k := j + 1; k < 5; k++ {
                    if remaining[k] == 0 {
                        continue
                    }
                    for l := k + 1; l < 5; l++ {
                        if remaining[l] == 0 {
                            continue
                        }
                        total += 4 * 640 // 4 books at 20% discount = $6.40 each
                        remaining[i]--
                        remaining[j]--
                        remaining[k]--
                        remaining[l]--
                        found = true
                        break
                    }
                    if found {
                        break
                    }
                }
                if found {
                    break
                }
            }
            if found {
                break
            }
        }
        if found {
            continue
        }

        // Try to form a group of 3
        found = false
        for i := 0; i < 5; i++ {
            if remaining[i] == 0 {
                continue
            }
            for j := i + 1; j < 5; j++ {
                if remaining[j] == 0 {
                    continue
                }
                for k := j + 1; k < 5; k++ {
                    if remaining[k] == 0 {
                        continue
                    }
                    total += 3 * 720 // 3 books at 10% discount = $7.20 each
                    remaining[i]--
                    remaining[j]--
                    remaining[k]--
                    found = true
                    break
                }
                if found {
                    break
                }
            }
            if found {
                break
            }
        }
        if found {
            continue
        }

        // Try to form a group of 2
        found = false
        for i := 0; i < 5; i++ {
            if remaining[i] > 0 {
                for j := i + 1; j < 5; j++ {
                    if remaining[j] > 0 {
                        total += 2 * 760 // 2 books at 5% discount = $7.60 each
                        remaining[i]--
                        remaining[j]--
                        found = true
                        break
                    }
                }
                if found {
                    break
                }
            }
        }
        if found {
            continue
        }

        // If no groups can be formed, add single books
        for i := 0; i < 5; i++ {
            if remaining[i] > 0 {
                total += 800 // Single book at full price
                remaining[i]--
            }
        }
    }

    return total
}
```

This implementation:

1. Counts how many of each book (1-5) are in the input
2. Uses a greedy approach to form the largest possible discount groups first (5, then 4, then 3, then 2)
3. For each group size, it tries all possible combinations of books to form groups
4. Adds the cost of each group with the appropriate discount
5. Continues until all books are processed
6. Returns the total cost in cents

The solution handles all the edge cases mentioned in the problem, including cases where some books can't form complete groups and need to be counted individually.
