def recite(start_verse, end_verse):
    """
    Generate the lyrics of the cumulative song "I Know an Old Lady Who Swallowed a Fly"
    from verse `start_verse` to verse `end_verse` (1-indexed, inclusive).

    Parameters
    ----------
    start_verse : int
        The first verse number to include.
    end_verse : int
        The last verse number to include.

    Returns
    -------
    str
        The requested portion of the song, with verses separated by a blank line.
    """
    # Define the animals in order and the special lines that accompany each
    animals = [
        ("fly", "I know an old lady who swallowed a fly.", "I don't know why she swallowed the fly. Perhaps she'll die."),
        ("spider", "I know an old lady who swallowed a spider.", "It wriggled and jiggled and tickled inside her."),
        ("bird", "I know an old lady who swallowed a bird.", "How absurd to swallow a bird!"),
        ("cat", "I know an old lady who swallowed a cat.", "Imagine that, to swallow a cat!"),
        ("dog", "I know an old lady who swallowed a dog.", "What a hog, to swallow a dog!"),
        ("goat", "I know an old lady who swallowed a goat.", "Just opened her throat and swallowed a goat!"),
        ("cow", "I know an old lady who swallowed a cow.", "I don't know how she swallowed a cow!"),
        ("horse", "I know an old lady who swallowed a horse.", "She's dead, of course!"),
    ]

    # Build the cumulative lines that describe the chain of swallowing
    # For each animal except the first (fly) and the last (horse),
    # we need a line that says "She swallowed the X to catch the Y".
    # The Y is the animal that was swallowed immediately before X.
    cumulative_lines = {}
    for i in range(1, len(animals) - 1):
        current = animals[i][0]
        previous = animals[i - 1][0]
        # Special case: when the previous animal is a spider, we need to
        # include the descriptive phrase about the spider.
        if previous == "spider":
            line = f"She swallowed the {current} to catch the {previous} that wriggled and jiggled and tickled inside her."
        else:
            line = f"She swallowed the {current} to catch the {previous}."
        cumulative_lines[current] = line

    # The last verse (horse) has no cumulative lines and ends the song.
    # Build each verse as a list of lines.
    verses = []
    for idx, (animal, intro, outro) in enumerate(animals, start=1):
        verse_lines = [intro]
        if animal == "horse":
            # The horse verse is just the intro line.
            verse_lines.append(outro)
        else:
            # Add cumulative lines from current animal down to the fly.
            # We start with the current animal's cumulative line (if any)
            # and then walk backwards through the animals list.
            # The fly verse is handled separately.
            # For the fly verse, we only have the intro and outro.
            if animal != "fly":
                # Add the cumulative line for the current animal
                verse_lines.append(cumulative_lines[animal])
                # Walk backwards adding lines for each previous animal
                for j in range(idx - 1, 0, -1):
                    prev_animal = animals[j - 1][0]
                    if prev_animal == "fly":
                        # The fly line is always the same
                        verse_lines.append("She swallowed the fly.")
                    else:
                        # For other animals, use the cumulative line
                        verse_lines.append(cumulative_lines[prev_animal])
            # Finally add the outro line
            verse_lines.append(outro)
        verses.append("\n".join(verse_lines))

    # Slice the requested range (1-indexed)
    selected = verses[start_verse - 1 : end_verse]
    return "\n\n".join(selected)
```
