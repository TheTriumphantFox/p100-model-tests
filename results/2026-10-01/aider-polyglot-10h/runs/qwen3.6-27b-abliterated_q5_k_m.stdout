import json


class RestAPI:
    def __init__(self, database=None):
        self.database = database or {}

    def get(self, url, payload=None):
        if url == "/users":
            if payload:
                users = payload.get("users", [])
                return {"users": [self._get_user(name) for name in sorted(users)]}
            else:
                return {"users": [self._get_user(name) for name in sorted(self.database.keys())]}
        return {}

    def post(self, url, payload=None):
        if url == "/add":
            user_name = payload.get("user")
            if user_name not in self.database:
                self.database[user_name] = {
                    "owes": {},
                    "owed_by": {},
                    "balance": 0.0
                }
            return self._get_user(user_name)
        elif url == "/iou":
            lender = payload.get("lender")
            borrower = payload.get("borrower")
            amount = payload.get("amount")

            # Ensure users exist
            if lender not in self.database:
                self.database[lender] = {
                    "owes": {},
                    "owed_by": {},
                    "balance": 0.0
                }
            if borrower not in self.database:
                self.database[borrower] = {
                    "owes": {},
                    "owed_by": {},
                    "balance": 0.0
                }

            # Update IOU
            self._update_iou(lender, borrower, amount)

            # Return updated user objects sorted by name
            users = sorted([lender, borrower])
            return {"users": [self._get_user(name) for name in users]}
        return {}

    def _get_user(self, name):
        if name in self.database:
            user_data = self.database[name]
            return {
                "name": name,
                "owes": user_data["owes"],
                "owed_by": user_data["owed_by"],
                "balance": user_data["balance"]
            }
        return None

    def _update_iou(self, lender, borrower, amount):
        # Update lender's data
        if borrower in self.database[lender]["owed_by"]:
            self.database[lender]["owed_by"][borrower] += amount
        else:
            self.database[lender]["owed_by"][borrower] = amount

        # Update borrower's data
        if lender in self.database[borrower]["owes"]:
            self.database[borrower]["owes"][lender] += amount
        else:
            self.database[borrower]["owes"][lender] = amount

        # Update balances
        self.database[lender]["balance"] += amount
        self.database[borrower]["balance"] -= amount
