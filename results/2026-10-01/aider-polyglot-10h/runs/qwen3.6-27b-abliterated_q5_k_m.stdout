import java.util.Random;
import java.util.Stack;
import java.util.ArrayList;
import java.util.List;

public class MazeGenerator {

    public char[][] generatePerfectMaze(int rows, int columns) {
        return generatePerfectMaze(rows, columns, new Random().nextInt());
    }

    public char[][] generatePerfectMaze(int rows, int columns, int seed) {
        Random random = new Random(seed);

        // The maze grid dimensions for characters
        int height = 2 * rows + 1;
        int width = 2 * columns + 1;
        char[][] grid = new char[height][width];

        // Initialize grid with a placeholder for walls
        for (int r = 0; r < height; r++) {
            for (int c = 0; c < width; c++) {
                grid[r][c] = ' '; // Temporary, will be replaced
            }
        }

        // Visited array for maze generation (cells are at odd indices)
        boolean[][] visited = new boolean[rows][columns];
        
        // Start at a random cell
        int startR = random.nextInt(rows);
        int startC = random.nextInt(columns);
        
        // Stack for DFS
        Stack<int[]> stack = new Stack<>();
        stack.push(new int[]{startR, startC});
        visited[startR][startC] = true;

        // Directions: Top, Right, Bottom, Left
        int[] dr = {-1, 0, 1, 0};
        int[] dc = {0, 1, 0, -1};

        while (!stack.isEmpty()) {
            int[] current = stack.peek();
            int r = current[0];
            int c = current[1];

            List<Integer> neighbors = new ArrayList<>();
            for (int i = 0; i < 4; i++) {
                int nr = r + dr[i];
                int nc = c + dc[i];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < columns && !visited[nr][nc]) {
                    neighbors.add(i);
                }
            }

            if (!neighbors.isEmpty()) {
                int dir = neighbors.get(random.nextInt(neighbors.size()));
                int nr = r + dr[dir];
                int nc = c + dc[dir];
                
                visited[nr][nc] = true;
                stack.push(new int[]{nr, nc});
            } else {
                stack.pop();
            }
        }

        // Now, build the character grid based on visited cells and connections
        // We need to know which walls are removed.
        // A wall between (r,c) and (nr,nc) is removed if both are visited and connected in the DFS tree.
        // Actually, simpler: during DFS, we can record the removed walls.
        // Let's use a boolean grid for walls. 
        // horizontalWalls[r][c] is true if there is a wall between cell (r,c) and (r,c+1)
        // verticalWalls[r][c] is true if there is a wall between cell (r,c) and (r+1,c)
        
        boolean[][] hWalls = new boolean[rows][columns - 1]; // Horizontal walls between col c and c+1
        boolean[][] vWalls = new boolean[rows - 1][columns]; // Vertical walls between row r and r+1

        // Initialize all walls as present
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < columns - 1; c++) {
                hWalls[r][c] = true;
            }
        }
        for (int r = 0; r < rows - 1; r++) {
            for (int c = 0; c < columns; c++) {
                vWalls[r][c] = true;
            }
        }

        // Re-run DFS to mark removed walls? Or just use the visited info?
        // The DFS stack approach above doesn't explicitly store edges.
        // Let's modify the DFS to store edges or just re-traverse.
        // Easier: Re-run a similar process or just check connectivity.
        // Since it's a perfect maze, there is a unique path.
        // Let's just use the visited array and check neighbors.
        // If cell (r,c) is visited and neighbor (nr,nc) is visited, is there a wall?
        // Not necessarily, because they might be connected via another path.
        // But in a DFS tree, if we moved from (r,c) to (nr,nc), the wall is removed.
        
        // Let's redo generation to track walls explicitly.
        
        // Reset
        visited = new boolean[rows][columns];
        stack = new Stack<>();
        startR = random.nextInt(rows);
        startC = random.nextInt(columns);
        stack.push(new int[]{startR, startC});
        visited[startR][startC] = true;
        
        // Reset walls
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < columns - 1; c++) {
                hWalls[r][c] = true;
            }
        }
        for (int r = 0; r < rows - 1; r++) {
            for (int c = 0; c < columns; c++) {
                vWalls[r][c] = true;
            }
        }

        while (!stack.isEmpty()) {
            int[] current = stack.peek();
            int r = current[0];
            int c = current[1];

            List<Integer> neighbors = new ArrayList<>();
            for (int i = 0; i < 4; i++) {
                int nr = r + dr[i];
                int nc = c + dc[i];
                if (nr >= 0 && nr < rows && nc >= 0 && nc < columns && !visited[nr][nc]) {
                    neighbors.add(i);
                }
            }

            if (!neighbors.isEmpty()) {
                int dir = neighbors.get(random.nextInt(neighbors.size()));
                int nr = r + dr[dir];
                int nc = c + dc[dir];
                
                // Remove wall
                if (dir == 0) { // Top
                    vWalls[nr][nc] = false;
                } else if (dir == 1) { // Right
