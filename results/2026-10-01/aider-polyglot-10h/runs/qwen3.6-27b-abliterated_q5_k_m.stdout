Based on the instructions, I will implement a `binary_search_tree` class 
template in C++.



Here are the changes:

1.  **binary_search_tree.h**: Define the `bst_node` struct and the 
`binary_search_tree` class template. The class will have a constructor taking 
the root value, an `insert` method, and a `root` accessor.

2.  **binary_search_tree.cpp**: Include the header (mostly empty implementation 
since it's a template class, but good practice to keep the file).



binary_search_tree.h

```diff
@@ -1,8 +1,53 @@
 #if !defined(BINARY_SEARCH_TREE_H)
 #define BINARY_SEARCH_TREE_H
 
+#include <string>
+#include <memory>
+
 namespace binary_search_tree {
+
+    template <typename T>
+    struct bst_node {
+        T data;
+        std::shared_ptr<bst_node<T>> left;
+        std::shared_ptr<bst_node<T>> right;
+
+        bst_node(T val) : data(val), left(nullptr), right(nullptr) {}
+    };
+
+    template <typename T>
+    class binary_search_tree {
+    public:
+        binary_search_tree(T root_val) : 
root_(std::make_shared<bst_node<T>>(root_val)) {}
+
+        void insert(T val) {
+            insert_helper(root_, val);
+        }
+
+        std::shared_ptr<bst_node<T>> root() const {
+            return root_;
+        }
+
+    private:
+        std::shared_ptr<bst_node<T>> root_;
+
+        void insert_helper(std::shared_ptr<bst_node<T>> current, T val) {
+            if (val <= current->data) {
+                if (current->left) {
+                    insert_helper(current->left, val);
+                } else {
+                    current->left = std::make_shared<bst_node<T>>(val);
+                }
+            } else {
+                if (current->right) {
+                    insert_helper(current->right, val);
+                } else {
+                    current->right = std::make_shared<bst_node<T>>(val);
+                }
+            }
+        }
+    };
 
 }  // namespace binary_search_tree
 
-#endif // BINARY_SEARCH_TREE_H+#endif // BINARY_SEARCH_TREE_H
```



