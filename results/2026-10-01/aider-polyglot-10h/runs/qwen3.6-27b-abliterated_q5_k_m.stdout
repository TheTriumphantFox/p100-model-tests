Added lib.rs to the chat.
To implement an arbitrary-precision `Decimal` class in Rust without external 
crates, we can represent the decimal number as an integer value (`i128` for 
sufficient precision for most exercises, though technically `BigInt` would be 
truly arbitrary) and a scale (number of decimal places).



Here are the changes:

1.  Define the `Decimal` struct with `value` (the significant digits as an 
integer) and `scale` (the number of digits after the decimal point).

2.  Implement `try_from` to parse the string, handling optional sign, integer 
part, and fractional part.

3.  Implement `PartialEq`, `Eq`, `PartialOrd`, `Ord` by normalizing the scale of
the two decimals before comparing their integer values.

4.  Implement `Add`, `Sub`, `Mul` by normalizing scales and performing integer 
arithmetic, adjusting the resulting scale appropriately.



lib.rs

```diff
@@ -1,10 +1,153 @@
 /// Type implementing arbitrary-precision decimal arithmetic
 pub struct Decimal {
-    // implement your type here
+    value: i128,
+    scale: u32,
 }
 
 impl Decimal {
     pub fn try_from(input: &str) -> Option<Decimal> {
-        todo!("Create a new decimal with a value of {input}")
+        let input = input.trim();
+        if input.is_empty() {
+            return None;
+        }
+
+        let mut parts = input.splitn(2, '.');
+        let int_part = parts.next()?;
+        let frac_part = parts.next();
+
+        let (sign, int_str) = if let Some(stripped) = 
int_part.strip_prefix('-') {
+            (-1, stripped)
+        } else if let Some(stripped) = int_part.strip_prefix('+') {
+            (1, stripped)
+        } else {
+            (1, int_part)
+        };
+
+        if int_str.is_empty() && frac_part.is_none() {
+            return None;
+        }
+
+        let int_val: i128 = int_str.parse().ok()?;
+        
+        let (frac_val, scale) = if let Some(frac) = frac_part {
+            if frac.is_empty() {
+                (0, 0)
+            } else {
+                let scale = frac.len() as u32;
+                let frac_val: i128 = frac.parse().ok()?;
+                (frac_val, scale)
+            }
+        } else {
+            (0, 0)
+        };
+
+        // Combine integer and fractional parts into a single integer value
+        // value = int_val * 10^scale + frac_val
+        let multiplier = 10_i128.pow(scale);
+        let combined = int_val * multiplier + frac_val;
+        
+        let final_value = combined * sign as i128;
+
+        Some(Decimal {
+            value: final_value,
+            scale,
+        })
+    }
+
+    fn normalize(&self, other_scale: u32) -> (i128, u32) {
+        if other_scale == self.scale {
+            (self.value, self.scale)
+        } else if other_scale > self.scale {
+            let diff = other_scale - self.scale;
+            let multiplier = 10_i128.pow(diff);
+            (self.value * multiplier, other_scale)
+        } else {
+            let diff = self.scale - other_scale;
+            let multiplier = 10_i128.pow(diff);
