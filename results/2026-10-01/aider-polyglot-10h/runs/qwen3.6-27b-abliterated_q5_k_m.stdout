To implement the protein translation logic, I will update `protein_translation.go`.

1.  Add the `errors` package to handle errors (e.g., invalid codons).
2.  Implement `FromCodon` to map a single 3-character codon string to its corresponding protein name or "STOP". It will return an error for unknown codons.
3.  Implement `FromRNA` to iterate through the RNA string in chunks of 3 characters (codons), calling `FromCodon` for each. It will accumulate proteins until a "STOP" codon is encountered or the end of the string is reached.

protein_translation.go
```
package protein

import "errors"

func FromRNA(rna string) ([]string, error) {
	var proteins []string
	for i := 0; i < len(rna); i += 3 {
		codon := rna[i:min(i+3, len(rna))]
		protein, err := FromCodon(codon)
		if err != nil {
			return nil, err
		}
		if protein == "STOP" {
			break
		}
		proteins = append(proteins, protein)
	}
	return proteins, nil
}

func FromCodon(codon string) (string, error) {
	switch codon {
	case "AUG":
		return "Methionine", nil
	case "UUU", "UUC":
		return "Phenylalanine", nil
	case "UUA", "UUG":
		return "Leucine", nil
	case "UCU", "UCC", "UCA", "UCG":
		return "Serine", nil
	case "UAU", "UAC":
		return "Tyrosine", nil
	case "UGU", "UGC":
		return "Cysteine", nil
	case "UGG":
		return "Tryptophan", nil
	case "UAA", "UAG", "UGA":
		return "STOP", nil
	default:
		return "", errors.New("invalid codon")
	}
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
```
