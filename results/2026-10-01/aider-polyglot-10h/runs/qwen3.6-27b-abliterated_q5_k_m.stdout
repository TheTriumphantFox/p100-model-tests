```
#include "diamond.h"
#include <string>
#include <vector>

namespace diamond {

std::vector<std::string> diamond(char letter) {
    int n = letter - 'A';
    int width = 2 * n + 1;
    std::vector<std::string> result;

    // Top half including middle
    for (int i = 0; i <= n; ++i) {
        std::string row(width, ' ');
        char current_char = 'A' + i;
        row[i] = current_char;
        row[width - 1 - i] = current_char;
        result.push_back(row);
    }

    // Bottom half
    for (int i = n - 1; i >= 0; --i) {
        std::string row(width, ' ');
        char current_char = 'A' + i;
        row[i] = current_char;
        row[width - 1 - i] = current_char;
        result.push_back(row);
    }

    return result;
}

}  // namespace diamond
```
