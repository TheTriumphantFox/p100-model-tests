+                       currentIndex = (currentIndex + 1) % 12
+               case 'M': // whole step
+                       currentIndex = (currentIndex + 2) % 12
+               case 'A': // augmented second (whole + half)
+                       currentIndex = (currentIndex + 3) % 12
+               }
+               result = append(result, chromaticScale[currentIndex])
+       }
+
+       return result
