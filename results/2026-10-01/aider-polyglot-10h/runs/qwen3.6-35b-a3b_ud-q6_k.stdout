            std::string new_name;
            new_name += c1;
            new_name += c2;
            new_name += d1;
            new_name += d2;
            new_name += d3;

            if (used_names.find(new_name) == used_names.end()) {
                used_names.insert(new_name);
                return new_name;
            }
        }
    }
}

robot::robot() : name_() {}

