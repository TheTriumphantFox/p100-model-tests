I will change `left()` and `right()` to be non-const methods that return `std::unique_ptr<tree>`. This allows the tests to take ownership (move) the child nodes if needed, which matches the `auto left = t.left();` usage pattern for `unique_ptr`.

binary_search_tree.h
```cpp
#if !defined(BINARY_SEARCH_TREE_H)
#define BINARY_SEARCH_TREE_H

#include <string>
#include <memory>

namespace binary_search_tree {

class tree {
public:
    tree(const std::string& data) : data_(data), left_(nullptr), right_(nullptr) {}

    const std::string& data() const { return data_; }
    std::unique_ptr<tree> left() { return std::move(left_); }
    std::unique_ptr<tree> right() { return std::move(right_); }

    void insert(const std::string& data) {
        if (data <= this->data_) {
            if (left_) {
                left_->insert(data);
            } else {
                left_ = std::make_unique<tree>(data);
            }
        } else {
            if (right_) {
                right_->insert(data);
            } else {
                right_ = std::make_unique<tree>(data);
            }
        }
    }

private:
    std::string data_;
    std::unique_ptr<tree> left_;
    std::unique_ptr<tree> right_;
};

}  // namespace binary_search_tree

