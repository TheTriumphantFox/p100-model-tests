```diff
@@ -1,3 +1,203 @@
 #include "zebra_puzzle.h"
-
-namespace zebra_puzzle {}  // namespace zebra_puzzle+#include <algorithm>
+#include <array>
+#include <vector>
+
+namespace zebra_puzzle {
+
+namespace {
+
+enum class Nationality { Englishman, Spaniard, Ukrainian, Norwegian, Japanese 
};
+enum class Color { Red, Green, Ivory, Yellow, Blue };
+enum class Drink { Coffee, Tea, Milk, OrangeJuice, Water };
+enum class Hobby { Dancing, Painter, Reading, Football, Chess };
+enum class Pet { Dog, Snail, Fox, Horse, Zebra };
+
+std::string nationality_name(Nationality n) {
+    switch (n) {
+        case Nationality::Englishman: return "Englishman";
+        case Nationality::Spaniard: return "Spaniard";
+        case Nationality::Ukrainian: return "Ukrainian";
+        case Nationality::Norwegian: return "Norwegian";
+        case Nationality::Japanese: return "Japanese";
+    }
+    return "";
+}
+
+Solution solve() {
+    std::array<Nationality, 5> nationalities = {
+        Nationality::Englishman, Nationality::Spaniard, Nationality::Ukrainian,
+        Nationality::Norwegian, Nationality::Japanese
+    };
+    std::array<Color, 5> colors = {
+        Color::Red, Color::Green, Color::Ivory, Color::Yellow, Color::Blue
+    };
+    std::array<Drink, 5> drinks = {
+        Drink::Coffee, Drink::Tea, Drink::Milk, Drink::OrangeJuice, 
Drink::Water
+    };
+    std::array<Hobby, 5> hobbies = {
+        Hobby::Dancing, Hobby::Painter, Hobby::Reading, Hobby::Football, 
Hobby::Chess
+    };
+    std::array<Pet, 5> pets = {
+        Pet::Dog, Pet::Snail, Pet::Fox, Pet::Horse, Pet::Zebra
+    };
+
+    do {
+        // 10. The Norwegian lives in the first house.
+        if (nationalities[0] != Nationality::Norwegian) continue;
+
+        do {
+            // 15. The Norwegian lives next to the blue house.
+            // Norwegian is at 0, so Blue must be at 1.
+            if (colors[1] != Color::Blue) continue;
+
+            do {
+                // 6. The green house is immediately to the right of the ivory 
house.
+                bool green_right_of_ivory = false;
+                for (int i = 0; i < 4; ++i) {
+                    if (colors[i] == Color::Ivory && colors[i+1] == 
Color::Green) {
+                        green_right_of_ivory = true;
+                        break;
+                    }
+                }
+                if (!green_right_of_ivory) continue;
+
+                // 2. The Englishman lives in the red house.
+                bool englishman_red = false;
+                for (int i = 0; i < 5; ++i) {
+                    if (nationalities[i] == Nationality::Englishman && 
colors[i] == Color::Red) {
+                        englishman_red = true;
+                        break;
+                    }
+                }
+                if (!englishman_red) continue;
+
+                do {
+                    // 9. The person in the middle house drinks milk.
+                    if (drinks[2] != Drink::Milk) continue;
+
+                    do {
+                        // 4. The person in the green house drinks coffee.
+                        bool green_coffee = false;
+                        for (int i = 0; i < 5; ++i) {
+                            if (colors[i] == Color::Green && drinks[i] == 
Drink::Coffee) {
+                                green_coffee = true;
+                                break;
+                            }
+                        }
+                        if (!green_coffee) continue;
+
+                        // 5. The Ukrainian drinks tea.
+                        bool ukrainian_tea = false;
+                        for (int i = 0; i < 5; ++i) {
+                            if (nationalities[i] == Nationality::Ukrainian && 
drinks[i] == Drink::Tea) {
+                                ukrainian_tea = true;
+                                break;
+                            }
+                        }
+                        if (!ukrainian_tea) continue;
+
+                        do {
+                            // 13. The person who plays football drinks orange 
juice.
+                            bool football_orange = false;
+                            for (int i = 0; i < 5; ++i) {
+                                if (hobbies[i] == Hobby::Football && drinks[i] 
== Drink::OrangeJuice) {
+                                    football_orange = true;
+                                    break;
+                                }
+                            }
+                            if (!football_orange) continue;
+
+                            // 14. The Japanese person plays chess.
+                            bool japanese_chess = false;
+                            for (int i = 0; i < 5; ++i) {
+                                if (nationalities[i] == Nationality::Japanese 
&& hobbies[i] == Hobby::Chess) {
+                                    japanese_chess = true;
+                                    break;
+                                }
+                            }
+                            if (!japanese_chess) continue;
+
+                            do {
+                                // 3. The Spaniard owns the dog.
+                                bool spaniard_dog = false;
+                                for (int i = 0; i < 5; ++i) {
+                                    if (nationalities[i] == 
Nationality::Spaniard && pets[i] == Pet::Dog) {
+                                        spaniard_dog = true;
+                                        break;
+                                    }
+                                }
+                                if (!spaniard_dog) continue;
+
+                                // 7. The snail owner likes to go dancing.
+                                bool snail_dancing = false;
+                                for (int i = 0; i < 5; ++i) {
+                                    if (pets[i] == Pet::Snail && hobbies[i] == 
Hobby::Dancing) {
+                                        snail_dancing = true;
+                                        break;
+                                    }
+                                }
+                                if (!snail_dancing) continue;
+
+                                // 8. The person in the yellow house is a 
painter.
