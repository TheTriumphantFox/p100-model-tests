            char d3 = '0' + digit_dist(gen);

            std::string new_name;
            new_name += c1;
            new_name += c2;
            new_name += d1;
            new_name += d2;
            new_name += d3;

            if (used_names.find(new_name) == used_names.end()) {
                used_names.insert(new_name);
                return new_name;
            }
        }
    }
}

robot::robot() : name_() {}

std::string robot::name() const {
    if (name_.empty()) {
        name_ = generate_unique_name();
    }
    return name_;
}

void robot::reset() {
    if (!name_.empty()) {
        used_names.erase(name_);
        name_ = "";
    }
}

}  // namespace robot_name
```
