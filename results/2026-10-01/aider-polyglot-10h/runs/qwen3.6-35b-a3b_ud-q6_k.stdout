			if board[nr][nc] == player {
				visited[key] = true
				queue = append(queue, struct{ r, c int }{nr, nc})
			}
		}
	}

	return false
}

func fmtKey(r, c int) string {
	return string(rune(r)) + "," + string(rune(c))
}
