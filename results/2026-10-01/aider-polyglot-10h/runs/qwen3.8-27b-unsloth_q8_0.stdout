two-bucket.js
```javascript
//
// This is only a SKELETON file for the 'Two Bucket' exercise. It's been provided as a
// convenience to get you started writing code faster.
//

export class TwoBucket {
  constructor(
    startBucket,
    goal,
    sizeOfBucketOne,
    sizeOfBucketTwo,
  ) {
    this.startBucket = startBucket;
    this.goal = goal;
    this.sizeOfBucketOne = sizeOfBucketOne;
    this.sizeOfBucketTwo = sizeOfBucketTwo;
  }

  solve() {
    const { startBucket, goal, sizeOfBucketOne, sizeOfBucketTwo } = this;

    if (goal > sizeOfBucketOne && goal > sizeOfBucketTwo) {
      throw new Error('No solution possible since input is greater than both buckets');
    }

    if (goal % this.gcd(sizeOfBucketOne, sizeOfBucketTwo) !== 0) {
      throw new Error('No solution possible since goal is not a multiple of the GCD of the bucket sizes');
    }

    const result1 = this.simulatePourFromStartToOther();
    const result2 = this.simulatePourFromOtherToStart();

    if (result1 && result2) {
      return result1.moves <= result2.moves ? result1 : result2;
    } else if (result1) {
      return result1;
    } else if (result2) {
      return result2;
    } else {
      throw new Error('No solution possible');
    }
  }

  simulatePourFromStartToOther() {
    const { startBucket, goal, sizeOfBucketOne, sizeOfBucketTwo } = this;
    
    let b1 = 0;
    let b2 = 0;
    let moves = 0;

    // First move: Fill start bucket
    if (startBucket === 'one') {
      b1 = sizeOfBucketOne;
    } else {
      b2 = sizeOfBucketTwo;
    }
    moves = 1;

    if (b1 === goal || b2 === goal) {
      return this.formatResult(moves, b1, b2);
    }

    const maxMoves = sizeOfBucketOne + sizeOfBucketTwo;
    
    while (moves < maxMoves) {
      // Pour from start to other
      if (startBucket === 'one') {
        const pourAmount = Math.min(b1, sizeOfBucketTwo - b2);
        b1 -= pourAmount;
        b2 += pourAmount;
      } else {
        const pourAmount = Math.min(b2, sizeOfBucketOne - b1);
        b2 -= pourAmount;
        b1 += pourAmount;
      }
      moves++;

      if (this.isForbiddenState(b1, b2)) {
        return null;
      }

      if (b1 === goal || b2 === goal) {
        return this.formatResult(moves, b1, b2);
      }

      // If start bucket is empty, fill it
      if (startBucket === 'one' && b1 === 0) {
        b1 = sizeOfBucketOne;
        moves++;
        if (b1 === goal || b2 === goal) {
          return this.formatResult(moves, b1, b2);
        }
      } else if (startBucket === 'two' && b2 === 0) {
        b2 = sizeOfBucketTwo;
        moves++;
        if (b1 === goal || b2 === goal) {
          return this.formatResult(moves, b1, b2);
        }
      }

      // If other bucket is full, empty it
      if (startBucket === 'one' && b2 === sizeOfBucketTwo) {
        b2 = 0;
        moves++;
        if (b1 === goal || b2 === goal) {
          return this.formatResult(moves, b1, b2);
        }
      } else if (startBucket === 'two' && b1 === sizeOfBucketOne) {
        b1 = 0;
        moves++;
        if (b1 === goal || b2 === goal) {
          return this.formatResult(moves, b1, b2);
        }
      }
    }

    return null;
  }

  simulatePourFromOtherToStart() {
    const { startBucket, goal, sizeOfBucketOne, sizeOfBucketTwo } = this;
    
    let b1 = 0;
    let b2 = 0;
    let moves = 0;

    // First move: Fill start bucket
    if (startBucket === 'one') {
      b1 = sizeOfBucketOne;
    } else {
      b2 = sizeOfBucketTwo;
    }
    moves = 1;

    if (b1 === goal || b2 === goal) {
      return this.formatResult(moves, b1, b2);
    }

    const maxMoves = sizeOfBucketOne + sizeOfBucketTwo;
    
    while (moves < maxMoves) {
      // Fill other bucket
      if (startBucket === 'one') {
        if (b2 !== sizeOfBucketTwo) {
          b2 = sizeOfBucketTwo;
          moves++;
          if (this.isForbiddenState(b1, b2)) return null;
          if (b1 === goal || b2 === goal) return this.formatResult(moves, b1, b2);
        }
      } else {
        if (b1 !== sizeOfBucketOne) {
          b1 = sizeOfBucketOne;
          moves++;
