+
+const Bst& Bst::left() const {
+    if (left_ == nullptr) {
+        return empty_;
+    }
+    return *left_;
+}
+
+const Bst& Bst::right() const {
+    if (right_ == nullptr) {
+        return empty_;
+    }
+    return *right_;
+}
