use std::cmp::Ordering;
use std::ops::{Add, Mul, Sub};

/// A simple arbitrary-precision integer implementation
#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
struct BigInt {
    sign: i8, // -1, 0, 1
    digits: Vec<u8>, // base 10, most significant first
}

impl BigInt {
    fn new() -> Self {
        BigInt {
            sign: 0,
            digits: vec![0],
        }
    }

    fn from_i128(val: i128) -> Self {
        if val == 0 {
            return BigInt::new();
        }
        let sign = if val < 0 { -1 } else { 1 };
        let abs_val = if val < 0 { -(val + 1) + 1 } else { val }; // Avoid overflow for i128::MIN
        let s = abs_val.to_string();
        let digits: Vec<u8> = s.bytes().map(|b| b - b'0').collect();
        BigInt { sign, digits }
    }

    fn from_string(s: &str) -> Option<Self> {
        let s = s.trim();
        if s.is_empty() {
            return None;
        }
        let (sign, digits_str) = if let Some(rest) = s.strip_prefix('-') {
            (-1, rest)
        } else if let Some(rest) = s.strip_prefix('+') {
            (1, rest)
        } else {
            (1, s)
        };

        if digits_str.is_empty() || !digits_str.chars().all(|c| c.is_ascii_digit()) {
            return None;
        }

        // Remove leading zeros
        let trimmed = digits_str.trim_start_matches('0');
        if trimmed.is_empty() {
            return Some(BigInt::new());
        }

        let digits: Vec<u8> = trimmed.bytes().map(|b| b - b'0').collect();
        Some(BigInt { sign, digits })
    }

    fn is_zero(&self) -> bool {
        self.sign == 0
    }

    fn abs(&self) -> Self {
        if self.sign == -1 {
            BigInt {
                sign: 1,
                digits: self.digits.clone(),
            }
        } else {
            self.clone()
        }
    }

    fn mul_by_10(&self) -> Self {
        if self.is_zero() {
            return self.clone();
        }
        let mut new_digits = self.digits.clone();
        new_digits.push(0);
        BigInt {
            sign: self.sign,
            digits: new_digits,
        }
    }

    fn div_by_10(&self) -> Self {
        if self.is_zero() {
            return self.clone();
        }
        let mut new_digits = self.digits.clone();
        new_digits.pop();
        if new_digits.is_empty() {
            return BigInt::new();
        }
        // Remove leading zeros if any (shouldn't happen if input was normalized, but safe)
        while new_digits.first() == Some(&0) && new_digits.len() > 1 {
            new_digits.remove(0);
        }
        BigInt {
            sign: self.sign,
            digits: new_digits,
        }
    }

    fn add(&self, other: &BigInt) -> Self {
        if self.is_zero() {
            return other.clone();
        }
        if other.is_zero() {
            return self.clone();
        }

        if self.sign == other.sign {
            let (a, b) = if self.digits.len() >= other.digits.len() {
                (self.digits.clone(), other.digits.clone())
            } else {
                (other.digits.clone(), self.digits.clone())
            };
            let mut result = vec![0u8; a.len() + 1];
            let mut carry = 0u8;
            for i in 0..a.len() {
                let da = a[a.len() - 1 - i];
                let db = if i < b.len() { b[b.len() - 1 - i] } else { 0 };
                let sum = da + db + carry;
                result[result.len() - 1 - i] = sum % 10;
                carry = sum / 10;
            }
            result[0] = carry;
            // Remove leading zeros
            let mut start = 0;
            while start < result.len() - 1 && result[start] == 0 {
                start += 1;
            }
            let digits = result[start..].to_vec();
            BigInt {
                sign: self.sign,
                digits,
            }
        } else {
            // Subtraction
            let (a, b, sign) = if self.cmp(other) >= Ordering::Equal {
                (self.digits.clone(), other.digits.clone(), self.sign)
            } else {
                (other.digits.clone(), self.digits.clone(), other.sign)
            };
            let mut result = vec![0u8; a.len()];
            let mut borrow = 0i8;
            for i in 0..a.len() {
                let da = a[a.len() - 1 - i];
                let db = if i < b.len() { b[b.len() - 1 - i] as i8 } else { 0 };
                let mut diff = da as i8 - db - borrow;
                if diff < 0 {
                    diff += 10;
                    borrow = 1;
                } else {
                    borrow = 0;
                }
                result[result.len() - 1 - i] = diff as u8;
            }
            // Remove leading zeros
            let mut start = 0;
            while start < result.len() - 1 && result[start] == 0 {
                start += 1;
            }
            let digits = result[start..].to_vec();
            if digits == vec![0] {
                BigInt::new()
            } else {
                BigInt { sign, digits }
            }
        }
    }

    fn sub(&self, other: &BigInt) -> Self {
        let neg_other = BigInt {
            sign: -other.sign,
            digits: other.digits.clone(),
        };
        self.add(&neg_other)
    }

    fn mul(&self, other: &BigInt) -> Self {
        if self.is_zero() || other.is_zero() {
            return BigInt::new();
        }
        let sign = self.sign * other.sign;
        let a = &self.digits;
        let b = &other.digits;
        let mut result = vec![0u8; a.len() + b.len()];
