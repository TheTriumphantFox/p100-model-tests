To implement the protein translation logic, I will update `protein_translation.go` with the following changes:

1.  Define a `codonMap` that maps each valid codon to its corresponding protein name.
2.  Implement `FromCodon` to look up a single codon in the map, returning an error for invalid codons.
3.  Implement `FromRNA` to iterate through the RNA string in chunks of 3 (codons), translating each one until a "STOP" codon is encountered or the end of the string is reached. It will return an error if an invalid codon is found.

Here is the updated file:

protein_translation.go
```go
package protein

import (
	"errors"
)

var codonMap = map[string]string{
	"AUG": "Methionine",
	"UUU": "Phenylalanine",
	"UUC": "Phenylalanine",
	"UUA": "Leucine",
	"UUG": "Leucine",
	"UCU": "Serine",
	"UCC": "Serine",
	"UCA": "Serine",
	"UCG": "Serine",
	"UAU": "Tyrosine",
	"UAC": "Tyrosine",
	"UGU": "Cysteine",
	"UGC": "Cysteine",
	"UGG": "Tryptophan",
	"UAA": "STOP",
	"UAG": "STOP",
	"UGA": "STOP",
}

func FromRNA(rna string) ([]string, error) {
	var proteins []string
	for i := 0; i < len(rna); i += 3 {
		if i+3 > len(rna) {
			return nil, errors.New("invalid codon")
		}
		codon := rna[i : i+3]
		protein, err := FromCodon(codon)
		if err != nil {
			return nil, err
		}
		if protein == "STOP" {
			break
		}
		proteins = append(proteins, protein)
	}
	return proteins, nil
}

func FromCodon(codon string) (string, error) {
	protein, ok := codonMap[codon]
	if !ok {
		return "", errors.New("invalid codon")
	}
	return protein, nil
}
```
