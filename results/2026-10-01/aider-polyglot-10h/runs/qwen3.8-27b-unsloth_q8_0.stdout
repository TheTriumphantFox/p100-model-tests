@@ -1,7 +1,73 @@
+import java.util.Random;
+import java.util.Stack;
+
 public class MazeGenerator {
 
     public char[][] generatePerfectMaze(int rows, int columns) {
-        throw new UnsupportedOperationException("Delete this statement and 
write your own implementation.");
+        return generatePerfectMaze(rows, columns, new Random().nextInt());
     }
 
     public char[][] generatePerfectMaze(int rows, int columns, int seed) {
+        if (rows < 5 || rows > 100 || columns < 5 || columns > 100) {
+            throw new IllegalArgumentException("Rows and columns must be 
between 5 and 100");
+        }
+
+        Random random = new Random(seed);
+        
+        // Grid dimensions for the maze structure
+        // Cells are at odd indices, walls at even indices
+        int height = 2 * rows + 1;
+        int width = 2 * columns + 1;
+
+        // isWall[r][c] is true if there is a wall at this position
+        boolean[][] isWall = new boolean[height][width];
+        
+        // Initialize all as walls
+        for (int i = 0; i < height; i++) {
+            for (int j = 0; j < width; j++) {
+                isWall[i][j] = true;
+            }
+        }
+
+        // Mark cells as not walls (passages)
+        for (int r = 0; r < rows; r++) {
+            for (int c = 0; c < columns; c++) {
+                isWall[2 * r + 1][2 * c + 1] = false;
+            }
+        }
+
+        // Recursive Backtracking (Randomized DFS)
+        boolean[][] visited = new boolean[rows][columns];
+        int[] dr = {0, 0, -1, 1};
+        int[] dc = {-1, 1, 0, 0};
+
+        // Start from a random cell
+        int startR = random.nextInt(rows);
+        int startC = random.nextInt(columns);
+        
+        Stack<int[]> stack = new Stack<>();
+        stack.push(new int[]{startR, startC});
+        visited[startR][startC] = true;
+
+        while (!stack.isEmpty()) {
+            int[] current = stack.peek();
+            int cr = current[0];
+            int cc = current[1];
+
+            // Find unvisited neighbors
