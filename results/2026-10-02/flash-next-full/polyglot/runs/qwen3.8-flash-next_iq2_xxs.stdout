sgf_parsing.py
```python
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string:
        raise ValueError("tree missing")
    
    # Basic validation: must start with '(' and end with ')'
    if not input_string.startswith('(') or not input_string.endswith(')'):
        raise ValueError("tree missing")
        
    # Remove outer parentheses
    content = input_string[1:-1]
    
    if not content:
        raise ValueError("tree with no nodes")
        
    if not content.startswith(';'):
        raise ValueError("tree missing")

    # Helper to parse a single node's properties
    def parse_node_properties(sgf_str, index):
        """
        Parses properties starting at index in sgf_str.
        Returns (properties_dict, next_index_after_node)
        """
        properties = {}
        i = index
        while i < len(sgf_str):
            char = sgf_str[i]
            if char == ';':
                # Next node starts
                break
            elif char == '(':
                # Start of child node
                break
            elif char == ')':
                # End of current node's subtree
                break
            elif char.isalpha():
                # Property key: uppercase letters
                if not char.isupper():
                    raise ValueError("property must be in uppercase")
                key = char
                i += 1
                # Consume remaining uppercase letters for the key
                while i < len(sgf_str) and sgf_str[i].isalpha():
                    if not sgf_str[i].isupper():
                        raise ValueError("property must be in uppercase")
                    key += sgf_str[i]
                    i += 1
                
                # Expect '[' for value start
                if i >= len(sgf_str) or sgf_str[i] != '[':
                    raise ValueError("properties without delimiter")
                
                # Parse values
                values = []
                while i < len(sgf_str) and sgf_str[i] == '[':
                    i += 1  # Skip '['
                    value = ""
                    while i < len(sgf_str):
                        if sgf_str[i] == ']':
                            i += 1  # Skip ']'
                            break
                        elif sgf_str[i] == '\\':
                            # Escape character
                            if i + 1 < len(sgf_str):
                                next_char = sgf_str[i+1]
                                if next_char == '\n':
                                    # Newline immediately after \ is removed
                                    i += 2
                                    continue
                                elif next_char.isspace():
                                    # Other whitespace converted to space
                                    value += ' '
                                    i += 2
                                    continue
                                else:
                                    # Non-whitespace inserted as-is
                                    value += next_char
                                    i += 2
                                    continue
                            else:
                                # Escape at end of string? Unlikely in valid SGF, but handle
                                value += '\\'
                                i += 1
                        elif sgf_str[i] == '\n':
                            # Newline not preceded by \ remains as newline
                            value += '\n'
                            i += 1
                        elif sgf_str[i].isspace():
                            # Other whitespace converted to space
                            value += ' '
                            i += 1
                        else:
                            value += sgf_str[i]
                            i += 1
                    values.append(value)
                
                properties[key] = values
            else:
                # Unexpected character in properties section
                raise ValueError("properties without delimiter")
                
        return properties, i

    def parse_node(sgf_str, index):
        """
        Parses a node starting at index (which should be ';').
        Returns (SgfTree, next_index_after_node)
        """
        if index >= len(sgf_str) or sgf_str[index] != ';':
            raise ValueError("tree missing")
            
        # Parse properties for this node
        properties, next_index = parse_node_properties(sgf_str, index + 1)
        
        children = []
        i = next_index
        
        # Parse children (variations)
        while i < len(sgf_str) and sgf_str[i] == '(':
            # Recursively parse child tree
            child_tree, i = parse_tree(sgf_str, i)
            children.append(child_tree)
            
        return SgfTree(properties, children), i

    def parse_tree(sgf_str, index):
        """
        Parses a tree starting at index (which should be '(').
        Returns (SgfTree, next_index_after_tree)
        """
        if index >= len(sgf_str) or sgf_str[index] != '(':
            raise ValueError("tree missing")
            
        # Skip '('
        i = index + 1
        
        # A tree must have at least one node
        if i >= len(sgf_str) or sgf_str[i] != ';':
            raise ValueError("tree with no nodes")
            
        # Parse the root node of this subtree
        root_node, i = parse_node(sgf_str, i)
        
        # Expect ')' to close the tree
        if i >= len(sgf_str) or sgf_str[i] != ')':
            raise ValueError("tree missing")
            
        # Skip ')'
        i += 1
        
        return root_node, i

    # Start parsing from the beginning of the content
    root_tree, _ = parse_tree(content, 0)
    return root_tree
```
