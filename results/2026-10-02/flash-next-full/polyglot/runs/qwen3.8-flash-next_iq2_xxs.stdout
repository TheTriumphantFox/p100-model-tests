This implements the conversion and checks the result against the expected values, fitting the provided signature.

octal.go
```
package octal

import (
	"fmt"
)

func ParseOctal(input string, expectedNum int64, expectErr bool) {
	decimal := int64(0)
	invalid := false

	// Check for invalid characters (non-octal digits)
	for _, c := range input {
		if c < '0' || c > '7' {
			invalid = true
			break
		}
	}

	if invalid {
		if !expectErr {
			panic(fmt.Sprintf("Expected no error for %s, but got invalid input", input))
		}
		return
	}

	// Calculate decimal value using first principles
	for _, c := range input {
		decimal = decimal*8 + int64(c-'0')
	}

	if expectErr {
		panic(fmt.Sprintf("Expected error for %s, but got %d", input, decimal))
	}

	if decimal != expectedNum {
		panic(fmt.Sprintf("Expected %d for %s, but got %d", expectedNum, input, decimal))
	}
}
```
