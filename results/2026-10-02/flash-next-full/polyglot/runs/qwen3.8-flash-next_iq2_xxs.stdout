I'll implement a binary search tree with insert and search functionality. The 
tree needs to support inserting values and searching for values, maintaining the
BST property where left subtree contains values ≤ current node and right subtree
contains values > current node.



binary_search_tree.h

```diff
@@ -1,8 +1,31 @@
 #if !defined(BINARY_SEARCH_TREE_H)
 #define BINARY_SEARCH_TREE_H
 
+#include <vector>
+
 namespace binary_search_tree {
+
+class binary_search_tree {
+public:
+    void insert(int value);
+    bool contains(int value) const;
+    std::vector<int> sorted() const;
+
+private:
+    struct Node {
+        int data;
+        Node* left;
+        Node* right;
+        Node(int val) : data(val), left(nullptr), right(nullptr) {}
+    };
+
+    Node* root;
+
+    void insert_node(Node*& node, int value);
+    bool contains_node(Node* node, int value) const;
+    void collect_sorted(Node* node, std::vector<int>& result) const;
+};
 
 }  // namespace binary_search_tree
 
-#endif // BINARY_SEARCH_TREE_H+#endif // BINARY_SEARCH_TREE_H
```



binary_search_tree.cpp

```diff
@@ -1,5 +1,55 @@
 #include "binary_search_tree.h"
 
 namespace binary_search_tree {
 
+void binary_search_tree::insert(int value) {
+    if (root == nullptr) {
+        root = new Node(value);
+    } else {
+        insert_node(root, value);
+    }
+}
+
+bool binary_search_tree::contains(int value) const {
+    return contains_node(root, value);
+}
+
+std::vector<int> binary_search_tree::sorted() const {
+    std::vector<int> result;
+    collect_sorted(root, result);
+    return result;
+}
+
+void binary_search_tree::insert_node(Node*& node, int value) {
+    if (node == nullptr) {
+        node = new Node(value);
+    } else if (value <= node->data) {
+        insert_node(node->left, value);
+    } else {
+        insert_node(node->right, value);
+    }
+}
+
+bool binary_search_tree::contains_node(Node* node, int value) const {
+    if (node == nullptr) {
+        return false;
+    }
+    if (value == node->data) {
+        return true;
+    } else if (value < node->data) {
+        return contains_node(node->left, value);
+    } else {
+        return contains_node(node->right, value);
+    }
+}
+
+void binary_search_tree::collect_sorted(Node* node, std::vector<int>& result) 
const {
+    if (node == nullptr) {
+        return;
+    }
+    collect_sorted(node->left, result);
+    result.push_back(node->data);
+    collect_sorted(node->right, result);
+}
+
 }  // namespace binary_search_tree
```


