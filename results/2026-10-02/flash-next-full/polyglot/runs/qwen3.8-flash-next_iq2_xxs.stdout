To implement the protein translation logic, I need to:

1. Define the mapping from codons to amino acids.
2. Implement `FromCodon` to look up the amino acid for a given codon, returning an error if the codon is invalid.
3. Implement `FromRNA` to process the RNA string in chunks of 3 nucleotides, translating each codon to a protein, stopping if a STOP codon is encountered, and returning the list of proteins.

Here is the updated `protein_translation.go`:

protein_translation.go
```go
package protein

import (
	"errors"
)

var ErrStop = errors.New("stop codon encountered")
var ErrInvalidRNA = errors.New("invalid RNA")

var codonTable = map[string]string{
	"AUG": "Methionine",
	"UUU": "Phenylalanine",
	"UUC": "Phenylalanine",
	"UUA": "Leucine",
	"UUG": "Leucine",
	"UCU": "Serine",
	"UCC": "Serine",
	"UCA": "Serine",
	"UCG": "Serine",
	"UAU": "Tyrosine",
	"UAC": "Tyrosine",
	"UGU": "Cysteine",
	"UGC": "Cysteine",
	"UGG": "Tryptophan",
	"UAA": "STOP",
	"UAG": "STOP",
	"UGA": "STOP",
}

func FromCodon(codon string) (string, error) {
	if protein, ok := codonTable[codon]; ok {
		if protein == "STOP" {
			return "", ErrStop
		}
		return protein, nil
	}
	return "", ErrInvalidRNA
}

func FromRNA(rna string) ([]string, error) {
	var proteins []string
	for i := 0; i < len(rna); i += 3 {
		if i+3 > len(rna) {
			return proteins, ErrInvalidRNA
		}
		codon := rna[i : i+3]
		protein, err := FromCodon(codon)
		if err != nil {
			if err == ErrStop {
				return proteins, nil
			}
			return proteins, err
		}
		proteins = append(proteins, protein)
	}
	return proteins, nil
}
```
