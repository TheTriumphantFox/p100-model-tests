}

impl Add for Decimal {
    type Output = Decimal;

    fn add(self, other: Decimal) -> Decimal {
        // Simple addition for positive numbers. Handle signs properly.
        // This is a simplified implementation.
        // For a full implementation, we need to handle signs and subtraction.
        // Let's assume both are positive for this simple add, or handle signs.
        // Actually, let's just do magnitude addition if signs are same, subtraction if different.
        
        if self.negative == other.negative {
            let digits = add_magnitudes(&self.digits, &other.digits);
            let scale = std::cmp::max(self.scale, other.scale);
            let mut res = Decimal { digits, scale, negative: self.negative };
            res.normalize();
            res
        } else {
            // Subtraction of magnitudes
            let cmp = compare_magnitudes(&self.digits, self.scale, &other.digits, other.scale);
            match cmp {
                Ordering::Equal => Decimal { digits: vec![0], scale: 0, negative: false },
                Ordering::Greater => {
                    let digits = sub_magnitudes(&self.digits, &other.digits);
                    let scale = std::cmp::max(self.scale, other.scale);
                    let mut res = Decimal { digits, scale, negative: self.negative };
                    res.normalize();
                    res
                }
                Ordering::Less => {
                    let digits = sub_magnitudes(&other.digits, &self.digits);
                    let scale = std::cmp::max(self.scale, other.scale);
                    let mut res = Decimal { digits, scale, negative: other.negative };
                    res.normalize();
                    res
                }
            }
        }
    }
}

impl Sub for Decimal {
    type Output = Decimal;

    fn sub(self, other: Decimal) -> Decimal {
        let mut neg_other = other.clone();
        neg_other.negative = !neg_other.negative;
        self.add(neg_other)
    }
}

impl Mul for Decimal {
    type Output = Decimal;

    fn mul(self, other: Decimal) -> Decimal {
        let negative = self.negative != other.negative;
        let digits = multiply_magnitudes(&self.digits, &other.digits);
        let scale = self.scale + other.scale;
        let mut res = Decimal { digits, scale, negative };
        res.normalize();
        res
    }
}

fn add_magnitudes(d1: &[u8], d2: &[u8]) -> Vec<u8> {
    let max_len = std::cmp::max(d1.len(), d2.len());
    let mut result = Vec::with_capacity(max_len + 1);
    let mut carry = 0;
    
    for i in 0..max_len {
        let a = d1.get(d1.len() - 1 - i).copied().unwrap_or(0);
        let b = d2.get(d2.len() - 1 - i).copied().unwrap_or(0);
        let sum = a + b + carry;
        result.push(sum % 10);
        carry = sum / 10;
    }
    if carry > 0 {
        result.push(carry);
    }
    result.reverse();
    result
}

fn sub_magnitudes(d1: &[u8], d2: &[u8]) -> Vec<u8> {
    // Assumes d1 >= d2 in magnitude
    let max_len = std::cmp::max(d1.len(), d2.len());
    let mut result = Vec::with_capacity(max_len);
    let mut borrow = 0;
    
    for i in 0..max_len {
        let a = d1.get(d1.len() - 1 - i).copied().unwrap_or(0);
        let b = d2.get(d2.len() - 1 - i).copied().unwrap_or(0);
        let mut diff = a as i32 - b as i32 - borrow;
        if diff < 0 {
            diff += 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        result.push(diff as u8);
    }
    while let Some(&last) = result.last() {
        if last == 0 {
            result.pop();
        } else {
            break;
        }
    }
    if result.is_empty() {
        result.push(0);
    }
    result.reverse();
    result
}

