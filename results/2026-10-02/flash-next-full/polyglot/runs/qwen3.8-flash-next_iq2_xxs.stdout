```rust
use std::cmp::Ordering;
use std::ops::{Add, Sub, Mul};

/// Type implementing arbitrary-precision decimal arithmetic
#[derive(Clone, Debug)]
pub struct Decimal {
    // digits stored as u8, most significant first, no leading zeros except for 0.0
    // if negative, the first digit is negated? No, let's store sign separately or handle in comparison.
    // Let's store digits as Vec<u8> where each u8 is 0-9.
    // And a boolean for negative.
    pub digits: Vec<u8>,
    pub scale: u32,
    pub negative: bool,
}

impl Decimal {
    pub fn try_from(input: &str) -> Option<Decimal> {
        let input = input.trim();
        if input.is_empty() {
            return None;
        }

        let mut negative = false;
        let mut chars = input.chars().peekable();
        
        // Check sign
        if let Some(&c) = chars.peek() {
            if c == '-' {
                negative = true;
                chars.next();
            } else if c == '+' {
                chars.next();
            }
        }

        let mut integer_part = String::new();
        let mut fractional_part = String::new();
        let mut has_dot = false;

        for c in chars {
            if c == '.' {
                if has_dot {
                    return None; // Multiple dots
                }
                has_dot = true;
                continue;
            }
            if !c.is_ascii_digit() {
                return None; // Invalid character
            }
            if !has_dot {
                integer_part.push(c);
            } else {
                fractional_part.push(c);
            }
        }

        // Normalize: remove leading zeros from integer part, but keep at least one digit if empty
        let int_str = integer_part.trim_start_matches('0');
        let frac_str = fractional_part.trim_end_matches('0');
        
        // Combine digits
        let mut digits_str = String::new();
        if int_str.is_empty() {
            digits_str.push('0');
        } else {
            digits_str.push_str(int_str);
        }
        digits_str.push_str(frac_str);

        // Convert to Vec<u8>
        let digits: Vec<u8> = digits_str.chars().map(|c| c.to_digit(10).unwrap() as u8).collect();
        
        // Calculate scale
        let scale = frac_str.chars().count() as u32;

        // Normalize: remove trailing zeros from the combined digits vector if they are in the fractional part?
        // Actually, the scale is determined by the fractional part length.
        // If we have "1.00", digits=[1,0,0], scale=2. Normalizing usually means removing trailing zeros from the *value*.
        // If we remove trailing zeros from digits, we must adjust scale.
        
        let mut digits = digits;
        let mut scale = scale;
        
        // Remove trailing zeros from digits vector
        while let Some(&last) = digits.last() {
            if last == 0 && scale > 0 {
                digits.pop();
                scale -= 1;
            } else {
                break;
            }
        }
        
        // Handle case where digits is empty (e.g. "0.0")
        if digits.is_empty() {
            digits.push(0);
        }
        
        // Check for negative zero
        if digits.len() == 1 && digits[0] == 0 {
            return Some(Decimal { digits, scale: 0, negative: false });
        }

        Some(Decimal { digits, scale, negative })
    }

    fn normalize(&mut self) {
        // Remove leading zeros from digits vector
        while self.digits.len() > 1 && self.digits[0] == 0 {
            self.digits.remove(0);
        }
        // Remove trailing zeros if they are in the fractional part (scale > 0)
        while self.scale > 0 && self.digits.last() == Some(&0) {
            self.digits.pop();
            self.scale -= 1;
        }
        // Ensure at least one digit
        if self.digits.is_empty() {
            self.digits.push(0);
            self.scale = 0;
            self.negative = false;
        }
        // Normalize negative zero
        if self.digits.len() == 1 && self.digits[0] == 0 {
            self.negative = false;
        }
    }
}

impl PartialEq for Decimal {
    fn eq(&self, other: &Self) -> bool {
        let mut a = self.clone();
        let mut b = other.clone();
        a.normalize();
        b.normalize();
        
        if a.negative != b.negative {
            // Check if both are zero
            let a_zero = a.digits.len() == 1 && a.digits[0] == 0;
            let b_zero = b.digits.len() == 1 && b.digits[0] == 0;
            if a_zero && b_zero {
                return true;
            }
            return false;
        }

        if a.scale != b.scale {
            return false;
        }

        if a.digits.len() != b.digits.len() {
            return false;
        }

        a.digits == b.digits
    }
}

impl Eq for Decimal {}

impl PartialOrd for Decimal {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for Decimal {
    fn cmp(&self, other: &Self) -> Ordering {
        let mut a = self.clone();
        let mut b = other.clone();
        a.normalize();
        b.normalize();

        // Handle signs
        if a.negative && !b.negative {
            return Ordering::Less;
        }
        if !a.negative && b.negative {
            return Ordering::Greater;
        }
        if a.negative && b.negative {
            // Both negative, reverse comparison of magnitudes
            return compare_magnitudes(&b.digits, &b.scale, &a.digits, &a.scale).reverse();
        }
        
        // Both positive (or zero)
        compare_magnitudes(&a.digits, &a.scale, &b.digits, &b.scale)
    }
}

fn compare_magnitudes(d1: &[u8], s1: u32, d2: &[u8], s2: u32) -> Ordering {
    // Pad with zeros to make scales equal
    let max_scale = std::cmp::max(s1, s2);
    let mut padded1 = d1.to_vec();
    let mut padded2 = d2.to_vec();
    
    // Add leading zeros to align decimal points? No, just pad fractional part.
    // Actually, to compare magnitudes, we can pad both to the same scale.
    // But we need to align the integer parts too.
    // Let's just pad both to max_scale.
    while padded1.len() < max_scale as usize {
        // This logic is tricky. Let's just pad the fractional part.
        // Actually, simpler: convert both to strings with same scale.
    }
    
    // Simpler approach: pad both digit vectors to have the same total length (integer + fractional)
    // We need to know the integer part length.
    // Let's just pad both to the same scale by adding zeros to the end.
