```go
package octal

import (
	"fmt"
	"strconv"
)

func ParseOctal(input string, expectedNum int64, expectErr bool) {
	// Implement conversion logic
	decimal := int64(0)
	invalid := false
	
	// Check for invalid characters (non-octal digits)
	for _, c := range input {
		if c < '0' || c > '7' {
			invalid = true
			break
		}
	}

	if invalid {
		if !expectErr {
			panic(fmt.Sprintf("Expected no error for %s, but got invalid input", input))
		}
		return
	}

	// Calculate decimal value
